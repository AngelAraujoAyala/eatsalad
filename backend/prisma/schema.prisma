datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum ServiceType {
  COMEDOR
  RECOGER
}

enum IngredientCategory {
  PROTEINA
  BARRA
  COMPLEMENTO
  ADEREZO
  TORTILLA
  PAN
}

enum OrderStatus {
  PENDIENTE
  FINALIZADO
  CANCELADO
}

// ==========================================
// MODELOS
// ==========================================

model Category {
  id       String    @id @default(uuid())
  name     String
  imageUrl String?
  products Product[]
}

model Product {
  id                   String              @id @default(uuid())
  name                 String
  price                Decimal             @db.Decimal(10, 2)
  description          String?
  imageUrl             String?
  isActive             Boolean             @default(true)
  categoryId           String
  category             Category            @relation(fields: [categoryId], references: [id])
  availableIngredients ProductIngredient[]
  
  isCustomizable       Boolean             @default(false) // Para saber si abre o no el modal
  rules                ProductRule[]

  orderItems           OrderItem[]
  comboItems           ComboItem[]

  @@index([isActive])
}

model ProductRule {
  id          String             @id @default(uuid())
  productId   String
  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  category    IngredientCategory
  minQuantity Int                @default(0) // 💡 Si es 1 o más, significa que es OBLIGATORIO (ej. 1 Pan, 1 Tortilla)
  maxQuantity Int                @default(1) // 💡 El límite máximo permitido antes de cobrar extra o bloquear

  @@unique([productId, category]) // Evita que un producto tenga reglas duplicadas para la misma categoría
}

model Ingredient {
  id        String              @id @default(uuid())
  name      String
  price     Decimal             @default(0) @db.Decimal(10, 2)
  isExtra   Boolean             @default(false)
  isActive  Boolean             @default(true)
  imageUrl  String?
  category  IngredientCategory?
  products  ProductIngredient[] 
}

model ProductIngredient {
  productId    String
  ingredientId String
  product      Product    @relation(fields: [productId], references: [id])
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@id([productId, ingredientId])
}

model Order {
  id           String      @id @default(uuid())
  customerName String      // Nombre del cliente para el flujo de EatSalad
  serviceType  ServiceType // COMEDOR o RECOGER
  pickupTime   String?     // Opcional. Almacena la hora formateada (Ej. "18:45") si es para recoger
  total        Decimal     @db.Decimal(10, 2)
  status       OrderStatus @default(PENDIENTE)
  createdAt    DateTime    @default(now())
  items        OrderItem[]
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  productId       String
  order           Order    @relation(fields: [orderId], references: [id])
  product         Product  @relation(fields: [productId], references: [id])
  quantity        Int
  priceAtPurchase Decimal  @db.Decimal(10, 2)
  configuration   Json     
}

model Combo {
  id          String      @id @default(uuid())
  name        String
  description String?
  imageUrl    String?
  price       Decimal     @db.Decimal(10, 2)
  isActive    Boolean     @default(true)
  items       ComboItem[]
}

model ComboItem {
  comboId   String
  productId String
  quantity  Int
  combo     Combo   @relation(fields: [comboId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@id([comboId, productId])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}